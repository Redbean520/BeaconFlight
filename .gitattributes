# Auto detect text files and perform LF normalization
* text=auto

# Java source files
*.java text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Gradle wrapper
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
